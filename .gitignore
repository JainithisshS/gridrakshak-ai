# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Large generated data files (>5 MB) ────────────────────────────────────────
# These are auto-generated by the pipeline — run `python run_pipeline.py`
data/raw/meter_readings.csv
data/processed/
outputs/meter_flags.csv
outputs/real_data_meter_flags.csv
outputs/real_data_meter_readings.csv

# ── Real dataset (auto-downloaded on first run) ────────────────────────────────
data/real/uci_raw.parquet
data/real/household_power_consumption.zip
data/real/household_power_consumption.txt

# ── Trained model binaries ─────────────────────────────────────────────────────
models/**/*.pkl
models/**/*.joblib
models/**/*.bin
!models/.gitkeep

# ── IDE ────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs (regenerated on each run) ────────────────────────────────────────────
logs/*.log
!logs/.gitkeep

# ── Pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage

# ── Temp ──────────────────────────────────────────────────────────────────────
*.tmp
*.bak
src/check_scores.py
